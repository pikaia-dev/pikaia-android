<?xml version="1.0" encoding="utf-8"?><!--
   Backup/transfer rules for API 31+.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Session tokens must never land in device backups (see sdk-auth README) -->
        <exclude
            domain="file"
            path="datastore/pikaia_tokens.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude
            domain="file"
            path="datastore/pikaia_tokens.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
